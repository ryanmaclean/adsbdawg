        ],
        "title": "Received 7700 frames",
        "precision": 0,
        "custom_unit": "frames"
      },
      "layout": {
        "x": 3,
        "y": 1,
        "width": 3,
        "height": 2
      }
    },
    {
      "id": 104,
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "sum:adsb.message{squawk:7600,$host}.as_count()",
