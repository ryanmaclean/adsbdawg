      "layout": {
        "x": 9,
        "y": 1,
        "width": 3,
        "height": 2
      }
    },
    {
      "id": 201,
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "avg:adsb.aircraft.active{$host}",
            "aggregator": "last",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 20,
                "palette": "white_on_green"
              },
              {
                "comparator": ">",
                "value": 5,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<=",
                "value": 5,
                "palette": "white_on_red"
              }
            ]
          }
        ],
        "title": "✈️ Aircraft in Range",
        "precision": 0
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 3,
        "height": 2
      }
    },
    {
      "id": 202,
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "sum:adsb.message{$host}.as_rate()",
            "aggregator": "avg",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 5,
                "palette": "white_on_green"
              },
              {
                "comparator": ">",
                "value": 1,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<=",
                "value": 1,
                "palette": "white_on_red"
              }
            ]
