{
  "title": "ADSB Aircraft Monitoring",
  "description": "Real-time aircraft telemetry from RTL-SDR dongle via dump1090. Includes receiver health, flight tracking, coverage analysis, squawk alerts, and Raspberry Pi system health. Aircraft panels filter current-frame ICAO24/country/host; callsign only filters the callsign-bearing frame table. Receiver and emergency panels use host only. Select the actual receiver host; no-data is not an all-clear.",
  "widgets": [
    {
      "id": 101,
      "definition": {
        "type": "note",
        "content": "## Received emergency observations\n\nCounts are received frames in the selected time window, not unique incidents or current aircraft state. Zero or no data cannot establish an all-clear. These cards and receiver-health panels use only the host filter; aircraft filters apply to aircraft panels below.",
        "background_color": "yellow",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 1
      }
    },
    {
      "id": 102,
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "sum:adsb.message{squawk:7500,$host}.as_count()",
            "aggregator": "sum",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 0,
                "palette": "white_on_red"
              }
            ]
          }
        ],
        "title": "Received 7500 frames",
        "precision": 0,
        "custom_unit": "frames"
      },
      "layout": {
        "x": 0,
        "y": 1,
        "width": 3,
        "height": 2
      }
    },
    {
      "id": 103,
      "definition": {
        "type": "query_value",
        "requests": [
          {
            "q": "sum:adsb.message{squawk:7700,$host}.as_count()",
